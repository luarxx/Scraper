# Intervalo da busca automática por termos salvos.
# O mínimo efetivo é 3 horas, mesmo que um valor menor seja informado.
AUTO_INTERVAL_HOURS=3

# Quantidade maxima de buscas automaticas simultaneas.
# Cada busca abre seu proprio Chromium; o padrao recomendado para a VPS atual e 3.
AUTO_MAX_CONCURRENCY=3

# Intervalo do Watch, que monitora URLs específicas e dispara alerta de queda.
# O mínimo efetivo também é 3 horas.
WATCH_INTERVAL_HOURS=3

# Conveniência local para rodar múltiplas instâncias/dev servers.
# Em produção, mantenha o .env da VPS como está salvo se for mudar Nginx/PM2.
PORT=3000
API_PORT=3000
CLIENT_PORT=5173

# Desabilita sites específicos nas rotas da API e nos schedulers.
# Use na VPS para remover lojas sem precisar de build separado.
# Exemplo: DISABLED_SITES=kabum
# Deixe vazio (ou comente) para manter todas as lojas ativas no DEV.
# DISABLED_SITES=kabum

# Webhook do Discord usado apenas pelo Watch quando o preço atual fica <= alvo.
# Deixe vazio para salvar verificações sem enviar notificações.
DISCORD_WEBHOOK_URL=

# Avatar opcional exibido nas mensagens enviadas pelo webhook do Discord.
DISCORD_WEBHOOK_AVATAR_URL=https://alguma-url-da-imagem.png
