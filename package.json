{
  "name": "scraper",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:fixed": "concurrently --kill-others \"cd client && vite\" \"tsx watch server.ts\"",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:server": "tsx watch server.ts",
    "dev:client": "cd client && vite",
    "build": "tsc",
    "build:client": "cd client && npm run build",
    "build:prod": "npm run build:client && npm run build",
    "start": "node dist/server.js",
    "test:discord": "tsx scripts/test-discord.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm test && cd client && npm test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.0",
    "jsdom": "^27.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.0.15"
  }
}
