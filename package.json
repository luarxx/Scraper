  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others \"cd client && npx vite\" \"tsx watch server.ts\"",
    "dev:server": "tsx server.ts",
    "dev:client": "cd client && npx vite",
    "build": "tsc",
    "build:client": "cd client && npm run build",
    "build:prod": "npm run build:client && npm run build",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit"
  },
